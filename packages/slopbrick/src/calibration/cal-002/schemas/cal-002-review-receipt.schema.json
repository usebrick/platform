{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usebrick.dev/schemas/cal-002-review-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "protocolVersion", "catalogSha256", "assignmentSha256", "blindedBatchSha256", "stateSha256", "reviewImplementationCommitSha", "reviewerAuthority", "rows", "admitted"],
  "properties": {
    "version": { "const": "cal-002-review-receipt-v1" },
    "protocolVersion": { "const": "CAL-002-v1" },
    "catalogSha256": { "$ref": "#/$defs/sha256" },
    "assignmentSha256": { "$ref": "#/$defs/sha256" },
    "blindedBatchSha256": { "$ref": "#/$defs/sha256" },
    "stateSha256": { "$ref": "#/$defs/sha256" },
    "reviewImplementationCommitSha": { "$ref": "#/$defs/commit" },
    "reviewerAuthority": { "const": "repository-owner" },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "admitted": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewId", "label"],
      "properties": {
        "reviewId": { "type": "string", "minLength": 1 },
        "label": { "enum": ["actionable-defect", "useful-no-safe-fix", "not-useful", "cannot-determine"] }
      }
    }
  }
}
