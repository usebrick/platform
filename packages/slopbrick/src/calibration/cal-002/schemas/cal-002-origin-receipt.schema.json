{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usebrick.dev/schemas/cal-002-origin-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "protocolVersion", "catalogSha256", "originImplementationCommitSha", "status", "governingHashes", "rows", "admitted"],
  "properties": {
    "version": { "const": "cal-002-origin-receipt-v1" },
    "protocolVersion": { "const": "CAL-002-v1" },
    "catalogSha256": { "$ref": "#/$defs/sha256" },
    "originImplementationCommitSha": { "$ref": "#/$defs/commit" },
    "status": { "enum": ["reused", "rerun-required", "rerun-completed"] },
    "governingHashes": { "$ref": "#/$defs/governingHashes" },
    "rows": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/hold" }, { "$ref": "#/$defs/transfer" }, { "$ref": "#/$defs/retire" }] } },
    "admitted": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "ruleId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$" },
    "governingHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolSha256", "sourceBindingReceiptSha256", "splitPlanSha256", "scannerCommitSha", "configSha256", "catalogSha256", "holdoutReceiptSha256", "metricsSha256", "cal001MatrixSha256", "reducerSha256"],
      "properties": {
        "protocolSha256": { "$ref": "#/$defs/sha256" },
        "sourceBindingReceiptSha256": { "$ref": "#/$defs/sha256" },
        "splitPlanSha256": { "$ref": "#/$defs/sha256" },
        "scannerCommitSha": { "$ref": "#/$defs/commit" },
        "configSha256": { "$ref": "#/$defs/sha256" },
        "catalogSha256": { "$ref": "#/$defs/sha256" },
        "holdoutReceiptSha256": { "$ref": "#/$defs/sha256" },
        "metricsSha256": { "$ref": "#/$defs/sha256" },
        "cal001MatrixSha256": { "$ref": "#/$defs/sha256" },
        "reducerSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "hold": {
      "type": "object", "additionalProperties": false,
      "required": ["ruleId", "disposition"],
      "properties": { "ruleId": { "$ref": "#/$defs/ruleId" }, "disposition": { "const": "hold-origin-default-off" } }
    },
    "transfer": {
      "type": "object", "additionalProperties": false,
      "required": ["ruleId", "disposition", "reason"],
      "properties": {
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "disposition": { "const": "transfer-to-quality" },
        "reason": { "enum": ["standards-or-contract-quality-claim", "contextual-defect-quality-claim", "statistical-review-utility-claim"] }
      }
    },
    "retire": {
      "type": "object", "additionalProperties": false,
      "required": ["ruleId", "disposition", "reason"],
      "properties": {
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "disposition": { "const": "retire" },
        "reason": { "const": "duplicate-or-obsolete" }
      }
    }
  }
}
