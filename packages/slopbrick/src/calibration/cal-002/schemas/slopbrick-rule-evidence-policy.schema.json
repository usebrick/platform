{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usebrick.dev/schemas/slopbrick-rule-evidence-policy-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["version", "protocolVersion", "catalogSha256", "finalMatrixSha256", "matrixApprovalSha256", "applicationImplementationCommitSha", "rows", "admitted", "applied"],
  "properties": {
    "version": { "const": "slopbrick-rule-evidence-policy-v1" }, "protocolVersion": { "const": "CAL-002-v1" },
    "catalogSha256": { "$ref": "#/$defs/sha256" }, "finalMatrixSha256": { "$ref": "#/$defs/sha256" }, "matrixApprovalSha256": { "$ref": "#/$defs/sha256" },
    "applicationImplementationCommitSha": { "$ref": "#/$defs/commit" }, "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "admitted": { "const": false }, "applied": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "ruleId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$" },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["ruleId", "outcome", "claimCeiling", "enabledByDefault", "scoreEligible", "provenance"],
      "properties": {
        "ruleId": { "$ref": "#/$defs/ruleId" }, "outcome": { "enum": ["default-on", "default-off", "quality-advisory", "insufficient-evidence", "retired"] },
        "claimCeiling": { "enum": ["deterministic-defect", "quality-usefulness", "review-target-utility", "internal-origin-association", "insufficient-evidence", "retired"] },
        "enabledByDefault": { "type": "boolean" }, "scoreEligible": { "type": "boolean" },
        "provenance": { "enum": ["deterministic-finding-evidence", "current-quality-calibrated", "advisory-review-utility", "internal-origin-calibrated", "current-quality-failed-claim-bar", "insufficient-evidence", "retired-policy"] }
      },
      "allOf": [{
        "if": { "properties": { "outcome": { "enum": ["default-off", "insufficient-evidence"] } }, "required": ["outcome"] },
        "then": { "properties": { "scoreEligible": { "const": false } } }
      }]
    }
  }
}
