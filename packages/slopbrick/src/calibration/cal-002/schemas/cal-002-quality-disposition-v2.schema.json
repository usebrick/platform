{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usebrick.dev/schemas/cal-002-quality-disposition-v2.schema.json",
  "title": "CAL-002 Quality Disposition v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "protocolVersion",
    "catalogSha256",
    "authorityReceiptSha256",
    "implementationCommitSha",
    "selectedRuleIds",
    "rows",
    "admitted",
    "applied"
  ],
  "properties": {
    "version": { "const": "cal-002-quality-disposition-v2" },
    "protocolVersion": { "const": "CAL-002-v2" },
    "catalogSha256": { "const": "d6d17e252b71e4918375c526c5c209a7550cb089a12f9d82281bb99883a1f506" },
    "authorityReceiptSha256": { "$ref": "#/$defs/sha256" },
    "implementationCommitSha": { "$ref": "#/$defs/commit" },
    "selectedRuleIds": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ruleId" }
    },
    "rows": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "prefixItems": [
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "ai/any-density" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "ai/console-debug-storm" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "ai/fetch-default-overuse" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "ai/state-default-overuse" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "ai/tailwind-color-overuse" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "component/giant-component" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "component/multiple-components-per-file" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "cpp/magic-numbers" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "cpp/printf-debug" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "dead/dead-branch" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "java/suspicious-implementation" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "layout/gap-monopoly" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "layout/spacing-grid" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "logic/boundary-violation" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/statisticalRow", "properties": { "ruleId": { "const": "logic/heaps-deviation" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/statisticalRow", "properties": { "ruleId": { "const": "logic/math-variable-name-entropy" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "logic/reactive-hook-soup" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/statisticalRow", "properties": { "ruleId": { "const": "logic/zipf-slope-anomaly" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "logic/zombie-state" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "perf/css-bloat" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "product/terminology-drift" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "rb/n-plus-one-query" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "rust/stringly-typed" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "rust/unwrap-in-production" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "security/dangerous-cors" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "security/fail-open-auth" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "test/duplicate-setup" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/statisticalRow", "properties": { "ruleId": { "const": "typo/math-button-label-uniformity" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "visual/arbitrary-escape" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "visual/inline-style-dominance" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "visual/radius-scale-violation" } } },
        { "type": "object", "additionalProperties": false, "patternProperties": { "^(evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true }, "$ref": "#/$defs/contextualRow", "properties": { "ruleId": { "const": "visual/spacing-scale-violation" } } }
      ],
      "items": false
    },
    "admitted": { "const": false },
    "applied": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "ruleId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$" },
    "sampleCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findings", "controls", "cannotDetermine"],
      "properties": {
        "findings": { "type": "integer", "minimum": 0 },
        "controls": { "type": "integer", "minimum": 0 },
        "cannotDetermine": { "type": "integer", "minimum": 0 }
      }
    },
    "zeroSampleCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findings", "controls", "cannotDetermine"],
      "properties": {
        "findings": { "const": 0 },
        "controls": { "const": 0 },
        "cannotDetermine": { "const": 0 }
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {
        "lower": { "type": "number", "minimum": 0, "maximum": 1 },
        "upper": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingUseful", "controlUseful"],
      "properties": {
        "findingUseful": { "$ref": "#/$defs/interval" },
        "controlUseful": { "$ref": "#/$defs/interval" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "evidenceClass",
        "measurementStatus",
        "sampleCounts",
        "runtimeOutcome",
        "enabledByDefault",
        "scoreEligible",
        "gateEligible",
        "repairSafety"
      ],
      "properties": {
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "evidenceClass": { "enum": ["contextual-quality", "statistical-review-utility"] },
        "measurementStatus": { "enum": ["measured", "not-requested-owner-capacity"] },
        "sampleCounts": { "$ref": "#/$defs/sampleCounts" },
        "uncertainty": { "$ref": "#/$defs/uncertainty" },
        "runtimeOutcome": {
          "enum": [
            "default-on",
            "default-off",
            "quality-advisory",
            "insufficient-evidence",
            "quality-candidate-default-off"
          ]
        },
        "enabledByDefault": { "type": "boolean" },
        "scoreEligible": { "type": "boolean" },
        "gateEligible": { "type": "boolean" },
        "repairSafety": { "enum": ["finding-bound-only", "no-safe-repair"] },
        "metricsRowSha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "measurementStatus": { "const": "not-requested-owner-capacity" } },
            "required": ["measurementStatus"]
          },
          "then": {
            "properties": {
              "sampleCounts": { "$ref": "#/$defs/zeroSampleCounts" },
              "runtimeOutcome": { "const": "quality-candidate-default-off" },
              "enabledByDefault": { "const": false },
              "scoreEligible": { "const": false },
              "gateEligible": { "const": false },
              "repairSafety": { "const": "no-safe-repair" }
            },
            "not": {
              "anyOf": [
                {
                  "properties": { "uncertainty": true },
                  "required": ["uncertainty"]
                },
                {
                  "properties": { "metricsRowSha256": true },
                  "required": ["metricsRowSha256"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "measurementStatus": { "const": "measured" } },
            "required": ["measurementStatus"]
          },
          "then": {
            "required": ["metricsRowSha256"],
            "properties": {
              "metricsRowSha256": { "$ref": "#/$defs/sha256" },
              "runtimeOutcome": {
                "enum": ["default-on", "default-off", "quality-advisory", "insufficient-evidence"]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "runtimeOutcome": { "const": "default-on" } },
                  "required": ["runtimeOutcome"]
                },
                "then": {
                  "properties": {
                    "enabledByDefault": { "const": true },
                    "scoreEligible": { "const": true },
                    "gateEligible": { "const": true }
                  }
                },
                "else": {
                  "properties": {
                    "enabledByDefault": { "const": false },
                    "scoreEligible": { "const": false },
                    "gateEligible": { "const": false }
                  }
                }
              },
              {
                "if": {
                  "properties": { "runtimeOutcome": { "const": "insufficient-evidence" } },
                  "required": ["runtimeOutcome"]
                },
                "then": {
                  "not": {
                    "properties": { "uncertainty": true },
                    "required": ["uncertainty"]
                  }
                },
                "else": {
                  "required": ["uncertainty"],
                  "properties": {
                    "uncertainty": { "$ref": "#/$defs/uncertainty" },
                    "sampleCounts": {
                      "type": "object",
                      "additionalProperties": false,
                      "patternProperties": { "^cannotDetermine$": true },
                      "properties": {
                        "findings": { "type": "integer", "minimum": 1 },
                        "controls": { "type": "integer", "minimum": 1 }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": { "evidenceClass": { "const": "statistical-review-utility" } },
            "required": ["evidenceClass"]
          },
          "then": {
            "properties": {
              "runtimeOutcome": {
                "enum": [
                  "default-off",
                  "quality-advisory",
                  "insufficient-evidence",
                  "quality-candidate-default-off"
                ]
              },
              "repairSafety": { "const": "no-safe-repair" }
            }
          }
        }
      ]
    },
    "contextualRow": {
      "allOf": [
        { "$ref": "#/$defs/row" },
        {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": { "^(ruleId|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true },
          "properties": {
            "evidenceClass": { "const": "contextual-quality" }
          }
        },
        {
          "if": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": { "^(ruleId|evidenceClass|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true },
            "properties": { "measurementStatus": { "const": "measured" } },
            "required": ["measurementStatus"]
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": { "^(ruleId|evidenceClass|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|metricsRowSha256)$": true },
            "properties": { "repairSafety": { "const": "finding-bound-only" } }
          }
        }
      ]
    },
    "statisticalRow": {
      "allOf": [
        { "$ref": "#/$defs/row" },
        {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": { "^(ruleId|measurementStatus|sampleCounts|uncertainty|runtimeOutcome|enabledByDefault|scoreEligible|gateEligible|repairSafety|metricsRowSha256)$": true },
          "properties": {
            "evidenceClass": { "const": "statistical-review-utility" }
          }
        }
      ]
    }
  }
}
