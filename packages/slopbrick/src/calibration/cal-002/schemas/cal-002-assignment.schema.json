{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usebrick.dev/schemas/cal-002-assignment-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "protocolVersion", "catalogSha256", "assignmentImplementationCommitSha", "assignmentId", "assignmentSha256", "selectionManifestSha256", "blindedBatchSha256", "round", "targetPerArm", "rows", "blindedRows", "admitted"],
  "properties": {
    "version": { "const": "cal-002-assignment-v1" },
    "protocolVersion": { "const": "CAL-002-v1" },
    "catalogSha256": { "$ref": "#/$defs/sha256" },
    "assignmentImplementationCommitSha": { "$ref": "#/$defs/commit" },
    "assignmentId": { "type": "string", "minLength": 1 },
    "assignmentSha256": { "$ref": "#/$defs/sha256" },
    "selectionManifestSha256": { "$ref": "#/$defs/sha256" },
    "blindedBatchSha256": { "$ref": "#/$defs/sha256" },
    "round": { "enum": ["initial", "final"] },
    "targetPerArm": { "enum": [30, 100] },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/privateRow" } },
    "blindedRows": { "type": "array", "items": { "$ref": "#/$defs/blindedRow" } },
    "admitted": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "round": { "const": "initial" } }, "required": ["round"] },
      "then": { "properties": { "targetPerArm": { "const": 30 } } },
      "else": { "properties": { "targetPerArm": { "const": 100 } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "ruleId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$" },
    "reviewClass": { "enum": ["contextual-quality", "statistical-review-utility"] },
    "privateRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewId", "ruleId", "evidenceClass", "role", "unitId"],
      "properties": {
        "reviewId": { "type": "string", "minLength": 1 },
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "evidenceClass": { "$ref": "#/$defs/reviewClass" },
        "role": { "enum": ["finding", "control"] },
        "unitId": { "type": "string", "minLength": 1 }
      }
    },
    "blindedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewId", "ruleId", "evidenceClass", "sourceIdentitySha256", "lineWindowLocator"],
      "properties": {
        "reviewId": { "type": "string", "minLength": 1 },
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "evidenceClass": { "$ref": "#/$defs/reviewClass" },
        "sourceIdentitySha256": { "$ref": "#/$defs/sha256" },
        "lineWindowLocator": { "type": "string", "minLength": 1 }
      }
    }
  }
}
