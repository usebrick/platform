{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usebrick.dev/schemas/cal-002-parity-receipt-v2.schema.json",
  "title": "CAL-002 Parity Receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "protocolVersion",
    "authorityReceiptSha256",
    "ruleId",
    "replacementRuleId",
    "migrationCommitSha",
    "uniqueCoverageDisposition",
    "reasonCode",
    "caseResults",
    "status",
    "admitted"
  ],
  "properties": {
    "version": { "const": "cal-002-parity-receipt-v2" },
    "protocolVersion": { "const": "CAL-002-v2" },
    "authorityReceiptSha256": { "$ref": "#/$defs/sha256" },
    "ruleId": {
      "enum": [
        "db/sql-concat",
        "logic/math-any-density",
        "logic/math-console-log-storm"
      ]
    },
    "replacementRuleId": {
      "enum": [
        "security/sql-construction",
        "ai/any-density",
        "ai/console-debug-storm"
      ]
    },
    "migrationCommitSha": { "$ref": "#/$defs/commit" },
    "uniqueCoverageDisposition": {
      "enum": ["ported", "rejected-as-false-positive", "split-to-new-rule"]
    },
    "splitRuleId": { "$ref": "#/$defs/ruleId" },
    "reasonCode": {
      "enum": [
        "with-query-coverage-ported",
        "line-denominator-not-type-bearing",
        "window-clustering-ported-with-guards"
      ]
    },
    "caseResults": { "type": "array" },
    "status": { "const": "passed" },
    "admitted": { "const": false }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "uniqueCoverageDisposition": { "const": "split-to-new-rule" }
        },
        "required": ["uniqueCoverageDisposition"]
      },
      "then": {
        "type": "object",
        "properties": { "splitRuleId": { "$ref": "#/$defs/ruleId" } },
        "required": ["splitRuleId"]
      },
      "else": {
        "type": "object",
        "not": {
          "type": "object",
          "properties": { "splitRuleId": true },
          "required": ["splitRuleId"]
        }
      }
    }
  ],
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ruleId": { "const": "db/sql-concat" },
        "replacementRuleId": { "const": "security/sql-construction" },
        "reasonCode": { "const": "with-query-coverage-ported" },
        "caseResults": { "$ref": "#/$defs/sqlCases" }
      }
    },
    {
      "type": "object",
      "properties": {
        "ruleId": { "const": "logic/math-any-density" },
        "replacementRuleId": { "const": "ai/any-density" },
        "reasonCode": { "const": "line-denominator-not-type-bearing" },
        "caseResults": { "$ref": "#/$defs/anyCases" }
      }
    },
    {
      "type": "object",
      "properties": {
        "ruleId": { "const": "logic/math-console-log-storm" },
        "replacementRuleId": { "const": "ai/console-debug-storm" },
        "reasonCode": { "const": "window-clustering-ported-with-guards" },
        "caseResults": { "$ref": "#/$defs/consoleCases" }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "ruleId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "sourceSha256",
        "expectedReplacementObservation",
        "observedReplacementObservation"
      ],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "expectedReplacementObservation": { "enum": ["finding", "no-finding"] },
        "observedReplacementObservation": { "enum": ["finding", "no-finding"] }
      }
    },
    "sqlTemplatePortedCase": {
      "type": "object",
      "$ref": "#/$defs/case",
      "properties": {
        "caseId": { "const": "sql-with-template-ported" },
        "expectedReplacementObservation": { "const": "finding" },
        "observedReplacementObservation": { "const": "finding" }
      }
    },
    "sqlParameterizedGuardCase": {
      "type": "object",
      "$ref": "#/$defs/case",
      "properties": {
        "caseId": { "const": "sql-with-parameterized-guard" },
        "expectedReplacementObservation": { "const": "no-finding" },
        "observedReplacementObservation": { "const": "no-finding" }
      }
    },
    "sqlCommentGuardCase": {
      "type": "object",
      "$ref": "#/$defs/case",
      "properties": {
        "caseId": { "const": "sql-with-comment-guard" },
        "expectedReplacementObservation": { "const": "no-finding" },
        "observedReplacementObservation": { "const": "no-finding" }
      }
    },
    "anyLineDensityRejectedCase": {
      "type": "object",
      "$ref": "#/$defs/case",
      "properties": {
        "caseId": { "const": "any-line-density-rejected" },
        "expectedReplacementObservation": { "const": "no-finding" },
        "observedReplacementObservation": { "const": "no-finding" }
      }
    },
    "anyDeclarationRatioRetainedCase": {
      "type": "object",
      "$ref": "#/$defs/case",
      "properties": {
        "caseId": { "const": "any-declaration-ratio-retained" },
        "expectedReplacementObservation": { "const": "finding" },
        "observedReplacementObservation": { "const": "finding" }
      }
    },
    "anyNonTypescriptGuardCase": {
      "type": "object",
      "$ref": "#/$defs/case",
      "properties": {
        "caseId": { "const": "any-non-typescript-guard" },
        "expectedReplacementObservation": { "const": "no-finding" },
        "observedReplacementObservation": { "const": "no-finding" }
      }
    },
    "consoleFiveInThirtyPortedCase": {
      "type": "object",
      "$ref": "#/$defs/case",
      "properties": {
        "caseId": { "const": "console-five-in-thirty-ported" },
        "expectedReplacementObservation": { "const": "finding" },
        "observedReplacementObservation": { "const": "finding" }
      }
    },
    "consoleWindowSpreadGuardCase": {
      "type": "object",
      "$ref": "#/$defs/case",
      "properties": {
        "caseId": { "const": "console-window-spread-guard" },
        "expectedReplacementObservation": { "const": "no-finding" },
        "observedReplacementObservation": { "const": "no-finding" }
      }
    },
    "consoleTestFileGuardCase": {
      "type": "object",
      "$ref": "#/$defs/case",
      "properties": {
        "caseId": { "const": "console-test-file-guard" },
        "expectedReplacementObservation": { "const": "no-finding" },
        "observedReplacementObservation": { "const": "no-finding" }
      }
    },
    "consoleLoggerFileGuardCase": {
      "type": "object",
      "$ref": "#/$defs/case",
      "properties": {
        "caseId": { "const": "console-logger-file-guard" },
        "expectedReplacementObservation": { "const": "no-finding" },
        "observedReplacementObservation": { "const": "no-finding" }
      }
    },
    "consoleStructuredLoggerGuardCase": {
      "type": "object",
      "$ref": "#/$defs/case",
      "properties": {
        "caseId": { "const": "console-structured-logger-guard" },
        "expectedReplacementObservation": { "const": "no-finding" },
        "observedReplacementObservation": { "const": "no-finding" }
      }
    },
    "sqlCases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/sqlTemplatePortedCase" },
        { "$ref": "#/$defs/sqlParameterizedGuardCase" },
        { "$ref": "#/$defs/sqlCommentGuardCase" }
      ],
      "items": false
    },
    "anyCases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/anyLineDensityRejectedCase" },
        { "$ref": "#/$defs/anyDeclarationRatioRetainedCase" },
        { "$ref": "#/$defs/anyNonTypescriptGuardCase" }
      ],
      "items": false
    },
    "consoleCases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "$ref": "#/$defs/consoleFiveInThirtyPortedCase" },
        { "$ref": "#/$defs/consoleWindowSpreadGuardCase" },
        { "$ref": "#/$defs/consoleTestFileGuardCase" },
        { "$ref": "#/$defs/consoleLoggerFileGuardCase" },
        { "$ref": "#/$defs/consoleStructuredLoggerGuardCase" }
      ],
      "items": false
    }
  }
}
