---
// CTASection — the last brick. The largest brick in the page.
// The current call to action is SlopBrick-first onboarding into
// the wider UseBrick repository contract.
import productFacts from '../data/product-facts.json';
---

<section class="cta" id="install">
  <div class="brick brick--cta brick--accent">
    <span class="cta__label">UseBrick coherence · SlopBrick v{productFacts.published.version} published</span>
    <h2 class="cta__title">
      One repository contract.<br />{' '}
      Start with the <em class="cta__em">shipped scanner</em>.
    </h2>
    <p class="cta__body">
      SlopBrick is the shipped local scanner and current CLI.
      Install with <code class="cta__code">npm install -g slopbrick</code>, run
      <code class="cta__code">slopbrick scan</code>, and keep reviewable evidence beside the code
      for developers, coding agents, and CI. The published catalog has {productFacts.published.ruleCount}{' '}
      rules in {productFacts.published.categoryCount} categories. MIT, no account required;
      local scan history on by default; outbound reporting off by default and endpoint-gated.
    </p>
    <div class="cta__buttons">
      <button class="btn btn--primary" data-copy="npm install -g slopbrick" data-magnetic>
        <svg class="btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        <span>npm install -g slopbrick</span>
      </button>
      <a class="btn" href="/docs">
        <svg class="btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
        </svg>
        <span>read the docs</span>
      </a>
    </div>
  </div>
</section>
