---
// Tools — one UseBrick capability loop. Each card has an explicit
// status so roadmap work never appears as a current product claim.

import BrickLayout from './BrickLayout.astro';
import productFacts from '../data/product-facts.json';

interface Tool {
  name: string;
  label: string;
  desc: string;
  icon: 'cli' | 'mcp' | 'schemas' | 'constitution';
  /** v0.43.0 editorial layout: the CLI is the main entry point,
   *  so it gets the featured treatment (spans both columns). */
  featured?: boolean;
}

const tools: Tool[] = [
  {
    name: 'SlopBrick',
    label: 'OBSERVE · SHIPPED',
    desc: `The shipped local scanner and current CLI. Published v${productFacts.published.version} carries ${productFacts.published.ruleCount} rules in ${productFacts.published.categoryCount} categories and emits repository-owned evidence.`,
    icon: 'cli',
    featured: true,
  },
  {
    name: 'Memory',
    label: 'PRESERVE + COMPILE · PLANNED',
    desc: 'A planned capability for preserving approved intent and compiling fresh, bounded context from repository-owned facts and provenance. It is not a shipped memory service.',
    icon: 'mcp',
  },
  {
    name: 'Lock',
    label: 'PREVENT DRIFT · PLANNED',
    desc: 'A planned new-debt gate inside the current CLI: enforce only reviewed policy without demanding a repository-wide cleanup. Paid enforcement does not ship today.',
    icon: 'schemas',
  },
  {
    name: 'Mend',
    label: 'REPAIR · PARKED',
    desc: 'A parked capability for narrow, deterministic, reversible repairs with receipts. It waits for trusted detection, enforcement, and rollback proof.',
    icon: 'constitution',
  },
  {
    name: 'Render Labs',
    label: 'VERIFY RUNTIME · LABS',
    desc: 'A benchmark-only experiment comparing source inspection with rendered and runtime evidence. It is not a browser product, package, shipped capability, or proven advantage.',
    icon: 'mcp',
  },
];
---

<section class="section tools" id="tools">
  <div class="brick-wall tools__wall">
    <BrickLayout as="header" tone="raised" class="tools__head" span={2}>
      <div class="tools__head-inner">
        <span class="tools__label">one product · capabilities, not separate products</span>
        <h2 class="tools__title">One loop. <span class="tools__title-accent">Shared repository truth.</span></h2>
        <p class="tools__body">
          Observe → Preserve intent → Compile context → Prevent drift → Repair → Verify runtime.
          SlopBrick ships today; Memory and Lock are planned, Mend is parked, and Render Labs is a bounded benchmark.
          Policy authoring stays inside UseBrick onboarding rather than becoming another product.
        </p>
      </div>
    </BrickLayout>

    {tools.map((t) => (
      <BrickLayout
        as="article"
        tone="default"
        class={`tools__brick tools__brick--${t.icon}${t.featured ? ' tools__brick--featured' : ''}`}
        data-tool={t.icon}
        span={t.featured ? 2 : 1}
      >
        <article
          class="tool-card"
          role="button"
          tabindex="0"
          aria-label={`Crack the ${t.label} brick`}
        >
          <svg class="tool-card__icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {t.icon === 'cli' && (
              <>
                <polyline points="4 17 10 11 4 5" />
                <line x1="12" y1="19" x2="20" y2="19" />
              </>
            )}
            {t.icon === 'mcp' && (
              <>
                <rect x="3" y="6" width="18" height="12" rx="2" />
                <path d="M7 10h.01M11 10h.01M15 10h.01M7 14h10" />
              </>
            )}
            {t.icon === 'schemas' && (
              <>
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <polyline points="14 2 14 8 20 8" />
                <line x1="9" y1="13" x2="15" y2="13" />
                <line x1="9" y1="17" x2="13" y2="17" />
              </>
            )}
            {t.icon === 'constitution' && (
              <>
                <path d="M12 2l3 6 6 1-4.5 4.5L18 20l-6-3-6 3 1.5-6.5L3 9l6-1z" />
              </>
            )}
          </svg>
          <h3 class="tool-card__label">{t.label}</h3>
          <p class="tool-card__name">{t.name}</p>
          <p class="tool-card__desc">{t.desc}</p>
          <span class="tool-card__hint">click to crack</span>
          <svg class="tool-card__cracks" viewBox="0 0 280 160" preserveAspectRatio="none" aria-hidden="true">
            <line class="tool-card__crack" x1="140" y1="80" x2="140" y2="80" />
            <line class="tool-card__crack" x1="140" y1="80" x2="140" y2="80" />
            <line class="tool-card__crack" x1="140" y1="80" x2="140" y2="80" />
          </svg>
        </article>
      </BrickLayout>
    ))}
  </div>
</section>
